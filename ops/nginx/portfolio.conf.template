# Portfolio de Jordy Brian GBOKO, généré par ops/remote-setup.sh.
# Certbot ajoute ensuite lui-même le bloc HTTPS (443) et la redirection depuis HTTP.
server {
    listen 80;
    listen [::]:80;
    server_name __SERVER_NAMES__;

    root __REMOTE_DIR__/site;
    index index.html;
    charset utf-8;

    access_log /var/log/nginx/portfolio.access.log;
    error_log  /var/log/nginx/portfolio.error.log;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript text/javascript application/json image/svg+xml;

    # API Node (compteur de visites, Top 10) gérée par PM2
    location /api/ {
        proxy_pass http://127.0.0.1:__API_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 8k;
    }

    # Pages : toujours la dernière version
    location ~* \.html$ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # Code et styles : cache court, pour que les mises à jour arrivent vite
    location ~* \.(css|js)$ {
        expires 1h;
        try_files $uri =404;
    }

    # Images, polices, PDF : cache plus long
    location ~* \.(png|jpg|jpeg|svg|ico|woff2|pdf)$ {
        expires 7d;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    # Jamais de fichiers cachés (.git, .env…)
    location ~ /\. {
        deny all;
    }
}
